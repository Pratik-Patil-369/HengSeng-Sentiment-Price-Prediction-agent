# =====================================================================
# Hang Seng & KRX Multi-Source Sentiment Price Prediction Agent
# Environment Configuration
# =====================================================================

# Apify API Token & Actor ID
# Obtain token from: https://console.apify.com/account/integrations
APIFY_API_KEY=
APIFY_ACTOR_ID=apify/web-scraper

# Exa.ai (EXA.com) API Key
# Obtain from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Tavily Search API Key (alternative / complementary news source)
# Obtain from: https://app.tavily.com/
TAVILY_API_KEY=

# Pipeline Settings (Optional overrides)
LOOKBACK_DAYS=10
DEFAULT_EXCHANGE=ALL
