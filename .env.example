# =====================================================================
# Hang Seng & KRX Multi-Source Sentiment Price Prediction Agent
# Environment Configuration
# =====================================================================

# Apify API Token (Optional: if omitted, resilient direct-scraping and localized feeds are used)
# Obtain from: https://console.apify.com/account/integrations
APIFY_API_KEY=

# Exa.ai (EXA.com) API Key (Optional: if omitted, curated financial press feeds are used)
# Obtain from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Pipeline Settings (Optional overrides)
LOOKBACK_DAYS=10
DEFAULT_EXCHANGE=ALL
